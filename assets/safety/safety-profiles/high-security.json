{
  "schema_version": 1,
  "profile_id": "high-security",
  "rule_pack_ids": ["korean-sensitive", "secret-api-key"],
  "eval_dataset_ids": ["safety-default"],
  "masking_policy": {
    "format": "label_numbered",
    "same_value_same_mask": true
  },
  "model_policy": {
    "enabled": true,
    "mode": "required",
    "model_id": "openai-privacy-filter",
    "max_input_chars": 4096,
    "timeout_ms": 1500,
    "run_when": ["external_export"],
    "on_missing": "block_export",
    "on_timeout": "block_export",
    "on_error": "block_export"
  }
}
