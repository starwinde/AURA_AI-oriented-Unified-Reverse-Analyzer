{
  "schema_version": 1,
  "rules": [
    {
      "id": "secret/api-key",
      "kind": "api_key",
      "pattern": "(api[_\\- ]?key|secret|token|password|passwd)[A-Za-z0-9_ .:=\\-]{0,24}['\"]?[A-Za-z0-9_\\-]{16,}",
      "confidence": 0.90,
      "flags": ["case_insensitive"]
    },
    {
      "id": "secret/bearer-token",
      "kind": "token",
      "pattern": "Bearer[ \\t]+[A-Za-z0-9_\\-\\.]{16,}",
      "confidence": 0.92
    },
    {
      "id": "secret/url",
      "kind": "url",
      "pattern": "https?://[A-Za-z0-9.\\-_/:%?&=#]+",
      "confidence": 0.82
    },
    {
      "id": "secret/ipv4",
      "kind": "ip_address",
      "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
      "confidence": 0.76
    },
    {
      "id": "secret/windows-path",
      "kind": "internal_path",
      "pattern": "[A-Za-z]:\\\\(?:[^\\\\/:*?\"<>|\\r\\n]+\\\\)*[^\\\\/:*?\"<>|\\r\\n]*",
      "confidence": 0.78
    },
    {
      "id": "secret/posix-path",
      "kind": "internal_path",
      "pattern": "/(?:home|Users|var|etc|opt|srv|mnt)/[A-Za-z0-9._/\\-]+",
      "confidence": 0.78
    }
  ]
}
